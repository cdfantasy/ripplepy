&MGRID_NLI
  TASK = 'MGRID'
  MGRID_EXT = '2b40R1mB01' ! For file coils.testcoil
  MGRID_MODE = 'S'       ! (S)caled or (R)aw
  LSTELL_SYM = T         ! Enforce flip-mirro symmetry
  RMIN = 0.4            ! Minimum R extent of grid [m]
  RMAX = 1.6            ! Maximum R extent of grid [m]
  ZMIN = -0.7          ! Minimum Z extent of grid [m]
  ZMAX = 0.7             ! Maximum Z extent of grid [m]
  KP   = 360              ! Number of toroidal planes
  IR   = 121             ! Number of R gridpoints
  JZ   = 141             ! Number of Z gridpoints
/
end